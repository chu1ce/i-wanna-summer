<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>До лета</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            padding: 10px;
        }
        
        .container { text-align: center; }
        
        .title {
            font-size: 1.2rem;
            margin-bottom: 15px;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
        }
        
        .countdown {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
        }
        
        .time-block {
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 12px 8px;
            min-width: 60px;
        }
        
        .time-value {
            font-size: 1.8rem;
            font-weight: bold;
        }
        
        .time-label {
            font-size: 0.65rem;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .summer {
            font-size: 1.5rem;
            animation: pulse 2s infinite;
        }
        
        .summer-emoji {
            font-size: 3rem;
            display: block;
            margin-bottom: 10px;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div id="content"></div>
    </div>
    
    <script>
        function getMoscowTime() {
            return new Date(new Date().toLocaleString("en-US", {timeZone: "Europe/Moscow"}));
        }
        
        function isSummer(date) {
            const month = date.getMonth();
            return month >= 5 && month <= 7; // Июнь, Июль, Август
        }
        
        function getNextSummerStart() {
            const moscow = getMoscowTime();
            let year = moscow.getFullYear();
            
            if (moscow.getMonth() > 7) year++; // После августа -> следующий год
            
            // 1 июня 00:00:00 по Москве
            const summerMoscow = new Date(`${year}-06-01T00:00:00+03:00`);
            return summerMoscow;
        }
        
        function pluralize(n, forms) {
            n = Math.abs(n) % 100;
            const n1 = n % 10;
            if (n > 10 && n < 20) return forms[2];
            if (n1 > 1 && n1 < 5) return forms[1];
            if (n1 === 1) return forms[0];
            return forms[2];
        }
        
        function updateCountdown() {
            const content = document.getElementById('content');
            const moscowNow = getMoscowTime();
            
            if (isSummer(moscowNow)) {
                content.innerHTML = `
                    <div class="summer">
                        <span class="summer-emoji">☀️🌴🏖️</span>
                        Сейчас лето!<br>Наслаждайся!
                    </div>
                `;
                return;
            }
            
            const summerStart = getNextSummerStart();
            const diff = summerStart.getTime() - Date.now();
            
            if (diff <= 0) {
                updateCountdown();
                return;
            }
            
            const totalSeconds = Math.floor(diff / 1000);
            const totalMinutes = Math.floor(totalSeconds / 60);
            const totalHours = Math.floor(totalMinutes / 60);
            const totalDays = Math.floor(totalHours / 24);
            
            const months = Math.floor(totalDays / 30);
            const days = totalDays % 30;
            const hours = totalHours % 24;
            const minutes = totalMinutes % 60;
            const seconds = totalSeconds % 60;
            
            const year = summerStart.getFullYear();
            
            content.innerHTML = `
                <h1 class="title">☀️ До лета ${year}</h1>
                <div class="countdown">
                    <div class="time-block">
                        <div class="time-value">${months}</div>
                        <div class="time-label">${pluralize(months, ['месяц', 'месяца', 'месяцев'])}</div>
                    </div>
                    <div class="time-block">
                        <div class="time-value">${days}</div>
                        <div class="time-label">${pluralize(days, ['день', 'дня', 'дней'])}</div>
                    </div>
                    <div class="time-block">
                        <div class="time-value">${String(hours).padStart(2, '0')}</div>
                        <div class="time-label">${pluralize(hours, ['час', 'часа', 'часов'])}</div>
                    </div>
                    <div class="time-block">
                        <div class="time-value">${String(minutes).padStart(2, '0')}</div>
                        <div class="time-label">${pluralize(minutes, ['минута', 'минуты', 'минут'])}</div>
                    </div>
                    <div class="time-block">
                        <div class="time-value">${String(seconds).padStart(2, '0')}</div>
                        <div class="time-label">${pluralize(seconds, ['секунда', 'секунды', 'секунд'])}</div>
                    </div>
                </div>
            `;
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
</body>
</html>
